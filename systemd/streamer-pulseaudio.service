[Unit]
Description=PulseAudio system-mode server (Soloist audio backend)
After=network.target sound.target streamer-audio-default.service
Wants=sound.target

[Service]
Group=audio
RuntimeDirectory=pulse
ExecStart=/usr/bin/pulseaudio --system --daemonize=no --disallow-exit --exit-idle-time=-1 --log-target=journal
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
