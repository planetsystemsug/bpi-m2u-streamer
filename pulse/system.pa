# Streamer box: single ALSA sink that follows the "default" PCM from
# /etc/asound.conf (managed by streamer-audio-default.sh). Soloist plays
# through this sink; MPD keeps writing to the same dmix directly via ALSA.
load-module module-alsa-sink device=default sink_name=soloist-sink
set-default-sink soloist-sink
load-module module-native-protocol-unix auth-anonymous=1
